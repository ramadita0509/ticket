# Travelport TripServices (mock by default)
TRAVELPORT_MODE=mock
TRAVELPORT_BASE_URL=https://api.pp.travelport.net/11
TRAVELPORT_AUTH_URL=https://auth.pp.travelport.net/oauth/token
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
TRAVELPORT_ACCESS_GROUP=
TRAVELPORT_PCC=

# SQLite (local) — no Postgres required for Phase 2–6
DATABASE_URL="file:./dev.db"

# Midtrans — leave empty to use mock Snap (demo pay button)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Redis optional — without it, booking runs in-process
REDIS_URL=

# Email optional — without SMTP, e-ticket is logged + downloadable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=El Wafa Travel <noreply@el-wafa-travel.local>

# Admin dashboard (/admin)
ADMIN_PASSWORD=elwafa-admin
ADMIN_SESSION_SECRET=change-me-in-production
